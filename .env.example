# Copy this file to .env and fill in your values before running docker compose.
# docker compose automatically loads .env from the same directory.

# ---- AI / LLM ---------------------------------------------------------------
# Required: your Groq API key (https://console.groq.com)
GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE

# Optional: Gemini key (only if you switch the AI engine to Gemini)
# GEMINI_API_KEY=your_gemini_key_here

# ---- NextAuth v5 ------------------------------------------------------------
# Required: a random secret string (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=change-me-to-a-random-secret-string

# Required: the public URL of the app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ---- Optional ---------------------------------------------------------------
# Override the host port (default: 3000)
# PORT=3000
